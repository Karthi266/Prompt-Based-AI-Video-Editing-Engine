# Required for natural-language prompt parsing in the main editor
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-2.5-flash

# Optional: required only for hosted text-to-video / video-editing models
REPLICATE_API_TOKEN=replace_with_your_replicate_token

# Optional: full path to a font file if drawtext cannot locate a suitable font
# VIDEO_EDITOR_FONT=C:\\Windows\\Fonts\\arial.ttf
